<?xml version="1.0"?>
<project name="tuProlog 1.4.1" default="do-release"><!-- LCG -->

	<target name="unit-test">
		<junit printsummary="on" dir="${unit-test.src.dir}"><!-- LCG -->
			<classpath>
				<pathelement location="${classes.dir}"/>
				<!-- LCG -->
				<pathelement location="${test.classes.dir}"/>
			</classpath>
			<batchtest fork="yes">
				<fileset dir="${unit-test.src.dir}">
					<include name="**/Test*.java"/><!-- LCG -->
				</fileset>
			</batchtest>
		</junit>
	</target>
	
	<property name="classes.dir" value="bin/classes"/><!-- LCG -->
	<!-- LCG -->
	<property name="test.classes.dir" value="bin/test/classes"/>
	
	<!-- LCG -->
	<property name="unit-test.src.dir" value="src/test/java"/>
	<property name="test.doc.dir" value="test/main/java/doc"/>
	<property name="test.lib.dir" value="test/main/java/lib"/>
	<property name="ant.fit.lib" value="ant-fit.jar"/>
	<property name="test.report.dir" value="test/main/java/report"/>
	
	<target name="fittask.define">
		<taskdef name="fit" classname="org.apache.tools.ant.taskdefs.optional.fit.FitTask" classpath="${test.lib.dir}/${ant.fit.lib}"/>
	</target>
	
	<target name="fitreporttask.define">
		<taskdef name="fitreport" classname="org.apache.tools.ant.taskdefs.optional.fit.FitReportTask" classpath="${test.lib.dir}/${ant.fit.lib}"/>
	</target>
	
	<target name="acceptance-test.report" depends="fitreporttask.define">
		<mkdir dir="${test.report.dir}"/>
		<fitreport destdir="${test.report.dir}" useWiki="false" classpath="${classes.dir}">
			<fileset dir="${test.doc.dir}">
				<!-- ISO Prolog -->
				<include name="isoAcceptanceTests.html"/>
				<!-- Bugs -->
				<include name="bugs.html"/>
			</fileset>
		</fitreport>
	</target>
	
	<target name="acceptance-test.report.clean">
		<delete dir="test/main/java/report"/>
	</target>
	
	<target name="acceptance-test" depends="fittask.define">
		<fit dir="${test.doc.dir}">
			<classpath>
				<path location="${classes.dir}"/>
			</classpath>
			<!-- ISO Prolog -->
			<document name="termUnification.html" right="37" wrong="7" ignores="0" exceptions="5"/>
			<document name="typeTesting.html" right="44" wrong="0" ignores="0" exceptions="0"/>
			<document name="termComparison.html" right="13" wrong="1" ignores="0" exceptions="1"/>
			<document name="termCreationAndDecomposition.html" right="58" wrong="8" ignores="19" exceptions="3"/>
			<document name="arithmeticEvaluation.html" right="7" wrong="2" ignores="1" exceptions="0"/>
			<document name="arithmeticComparison.html" right="21" wrong="3" ignores="6" exceptions="0"/>
			<document name="clauseRetrivalAndInformation.html" right="16" wrong="8" ignores="5" exceptions="3"/>
			<document name="clauseCreationAndDestruction.html" right="29" wrong="16" ignores="15" exceptions="4"/>
			<document name="allSolutions.html" right="57" wrong="46" ignores="4" exceptions="7"/>
			<document name="streamSelectionAndControl.html" right="0" wrong="7" ignores="0" exceptions="0"/>
			<document name="logicAndControl.html" right="12" wrong="4" ignores="2" exceptions="2"/>
			<document name="atomicTermProcessing.html" right="135" wrong="9" ignores="9" exceptions="27"/>
			<document name="implementationDefinedHooks.html" right="5" wrong="4" ignores="5" exceptions="0"/>
			<document name="simpleArithmeticFunctors.html" right="30" wrong="6" ignores="25" exceptions="0"/>
			<document name="otherArithmeticFunctors.html" right="21" wrong="6" ignores="17" exceptions="0"/>
			<document name="bitwiseFunctors.html" right="4" wrong="6" ignores="10" exceptions="2"/>
			<!-- Bugs -->
			<document name="bugs.html"/>
		</fit>
	</target>
	
	<!-- TODO Revision the whole Ant buildfile! -->
	
	<property name="src.dir" value="src/main/java"/><!-- LCG -->
	<property name="install.dir" value="lib"/>
	<property name="release.dir" value="release"/>

	<property name="2p.jar.name" value="2p.jar"/>
	<property name="applet.jar.name" value="tuprolog-applet.jar"/>
	<property name="tuprolog.jar.name" value="tuprolog.jar"/>
	<property name="tuprolog.ide.jar.name" value="tuprolog-ide.jar"/>
	<property name="tuprolog.extensions.jar.name" value="tuprolog-extensions.jar"/>

	<property name="alice.tuprolog.package" value="alice/tuprolog"/>
	<property name="alice.util.package" value="alice/util"/>
	<property name="alice.tuprologx.ide.package" value="alice/tuprologx/ide"/>
	<property name="alice.tuprologx.engine.package" value="alice/tuprologx/engine"/>
	<property name="alice.util.jedit.package" value="alice/util/jedit"/>
	<property name="alice.util.thinlet.package" value="alice/util/thinlet"/>
	<property name="alice.tuprologx.runtime.package" value="alice/tuprologx/runtime"/>

	<property name="keystore.alias" value="gpiancastelli"/>
	<property name="keystore.password" value="myKeyStore"/>
	<property name="keystore.store" value="${install.dir}/myKeyStore"/>
	<property name="keystore.alias.password" value="gpiancastelli"/>

	<property name="doc.src.dir" value="D:/Progetti/tuProlog/Docs"/>
	<property name="doc.dest.dir" value="doc"/>
	<property name="doc.user.guide" value="user-guide/userGuide.pdf"/>
	<property name="doc.developer.guide" value="developer-guide/developerGuide.pdf"/>
	<property name="doc.ide.guide" value="ide/ideUserGuide.pdf"/>
	<property name="doc.tuprolog.guide" value="tuPrologGuide.pdf"/>
	
	<target name="compile">
		<javac srcdir="${src.dir}" destdir="${classes.dir}"/>
		<!-- LCG -->
		<javac srcdir="${unit-test.src.dir}" 
			classpath="${classes.dir}"
			destdir="${test.classes.dir}"/>
	</target>

	<target name="build">
		<jar jarfile="${2p.jar.name}">
			<fileset dir="${classes.dir}"/>
			<fileset dir="${src.dir}">
				<include name="**/*.xml"/>
				<include name="**/*.gif"/>
				<include name="**/*.png"/>
			</fileset>
			<manifest>
				<attribute name="Main-Class" value="alice.tuprologx.ide.GUILauncher"/>
			</manifest>
		</jar>
	</target>

	<target name="complete-download">
		<jar jarfile="${install.dir}/${2p.jar.name}">
			<fileset dir="${classes.dir}"/>
			<fileset dir="${src.dir}">
				<include name="**/*.xml"/>
				<include name="**/*.gif"/>
				<include name="**/*.png"/>
			</fileset>
			<manifest>
				<attribute name="Main-Class" value="alice.tuprologx.ide.GUILauncher"/>
			</manifest>
		</jar>
		<copy file="${doc.src.dir}/${doc.user.guide}" todir="${doc.dest.dir}"/>
		<copy file="${doc.src.dir}/${doc.developer.guide}" todir="${doc.dest.dir}"/>
		<copy file="${doc.src.dir}/${doc.ide.guide}" todir="${doc.dest.dir}"/>
		<copy file="${doc.src.dir}/${doc.tuprolog.guide}" todir="${doc.dest.dir}"/>
		<zip destfile="${release.dir}/2p-1.2.1.zip">
			<fileset dir=".">
				<include name="${classes.dir}/**"/>
				<include name="${src.dir}/**"/>
				<include name="${doc.dest.dir}/**"/>
				<include name="${install.dir}/${2p.jar.name}"/>
			</fileset>
		</zip>
	</target>

	<target name="applet-library">
		<jar jarfile="${install.dir}/${applet.jar.name}">
			<fileset dir="${classes.dir}"/>
		</jar>
		<signjar jar="${install.dir}/${applet.jar.name}" alias="${keystore.alias}" storepass="${keystore.password}" keystore="${keystore.store}" keypass="${keystore.alias.password}"/>
	</target>

	<target name="jws-library">
		<jar jarfile="${install.dir}/${tuprolog.jar.name}">
			<fileset dir="${classes.dir}">
				<include name="${alice.tuprolog.package}/**/*.class"/>
				<include name="${alice.util.package}/*.class"/>
			</fileset>
		</jar>
		<jar jarfile="${install.dir}/${tuprolog.ide.jar.name}">
			<fileset dir="${classes.dir}">
				<include name="${alice.tuprologx.ide.package}/*.class"/>
				<include name="${alice.tuprologx.engine.package}/*.class"/>
				<include name="${alice.util.jedit.package}/*.class"/>
				<include name="${alice.util.thinlet.package}/*.class"/>
			</fileset>
			<fileset dir="${src.dir}">
				<include name="${alice.tuprologx.ide.package}/**/*.xml"/>
				<include name="${alice.tuprologx.ide.package}/**/*.gif"/>
				<include name="${alice.tuprologx.ide.package}/**/*.png"/>
			</fileset>
			<manifest>
				<attribute name="Main-Class" value="alice.tuprologx.ide.GUILauncher"/>
			</manifest>
		</jar>
		<jar jarfile="${install.dir}/${tuprolog.extensions.jar.name}">
			<fileset dir="${classes.dir}">
				<include name="${alice.tuprologx.runtime.package}/**/*.class"/>
			</fileset>
		</jar>

		<signjar jar="${install.dir}/${tuprolog.jar.name}" alias="${keystore.alias}" storepass="${keystore.password}" keystore="${keystore.store}" keypass="${keystore.alias.password}"/>
		<signjar jar="${install.dir}/${tuprolog.ide.jar.name}" alias="${keystore.alias}" storepass="${keystore.password}" keystore="${keystore.store}" keypass="${keystore.alias.password}"/>
		<signjar jar="${install.dir}/${tuprolog.extensions.jar.name}" alias="${keystore.alias}" storepass="${keystore.password}" keystore="${keystore.store}" keypass="${keystore.alias.password}"/>
	</target>

	<target name="jws-and-applet" depends="applet-library,jws-library">
		<zip destfile="${release.dir}/jwsAndApplet.zip">
			<fileset dir=".">
				<include name="${install.dir}/${applet.jar.name}"/>
				<include name="${install.dir}/${tuprolog.ide.jar.name}"/>
				<include name="${install.dir}/${tuprolog.extensions.jar.name}"/>
				<include name="${install.dir}/${tuprolog.jar.name}"/>
				<include name="Download.shtml"/>
				<include name="images/**"/>
				<include name="tuprolog.jnlp"/>
			</fileset>
		</zip>
	</target>

	<target name="src-download">
		<zip destfile="${release.dir}/src-J2SE-1.4.1.zip"><!-- LCG -->
			<fileset dir=".">
				<include name="${src.dir}/**"/>
			</fileset>
		</zip>
	</target>

	<target name="do-applet" depends="compile,applet-library"/>
	<target name="do-jws" depends="compile,jws-library"/>

	<target name="do-release" depends="jws-and-applet,complete-download,src-download"/>

</project>