<?xml version="1.0" encoding="ISO-8859-1"?>
<panel name="console" columns="1" gap="4" top="4" left="2" right="2" bottom="4">
    <tabbedpane selected="0" weighty="1" weightx="1">
        <tab text="Solution"/>
        <textarea name="solutionArea" editable="false"/>
        <tab text="Output"/>
        <textarea name="outputArea" editable="false"/>
    </tabbedpane>
    <panel columns="3" gap="4" halign="center">
        <button name="nextButton" text="Next" icon="StepForward16.gif"
            tooltip="Ask for next solution" enabled="false" action="getNextSolution"/>
        <button name="acceptButton" text="Accept" icon="Stop16.gif"
            tooltip="Accept current solution" enabled="false" action="acceptSolution"/>
        <button name="haltButton" text="Halt" icon="Stop16.gif"
            tooltip="Halt current demo" enabled="false" action="haltDemonstration"/>
    </panel>
</panel>